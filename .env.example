# ---------------------------------------------------------------------------
# Common prefix. Used for the compose project name, the network, all volumes
# and every container name (e.g. ddb-mysql, ddb-redis, ddb-minio).
# ---------------------------------------------------------------------------
PREFIX=ddb

# Host interface the published ports bind to.
# 127.0.0.1 = reachable only from the staging server itself (safest).
# 0.0.0.0   = reachable from your LAN/VPN. Change only if you need remote access.
BIND_ADDR=127.0.0.1

# --- images (pin these once you know what works on your staging box) --------
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
ADMINER_IMAGE=adminer:latest
PYTHON_IMAGE=python:3.12-slim

# --- MySQL (hot store) ------------------------------------------------------
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=activity
MYSQL_USER=activity
MYSQL_PASSWORD=

# --- Redis (queue) ----------------------------------------------------------
REDIS_PORT=16379
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=activity-archive
MINIO_REGION=us-east-1

# --- Adminer (optional MySQL UI, "tools" profile) ---------------------------
ADMINER_PORT=18080

# --- Archive worker ---------------------------------------------------------
# Rows pulled from MySQL per archive job.
ARCHIVE_BATCH_SIZE=50000
# Seconds between dispatcher sweeps of the outbox.
DISPATCH_INTERVAL=15
# A 'claimed' outbox row older than this (seconds) is returned to 'pending'.
RECLAIM_AFTER=300

# --- DuckDB runtime ---------------------------------------------------------
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
