[mysqld]
default-time-zone            = '+00:00'   # everything is stored and compared in UTC
character-set-server         = utf8mb4
collation-server             = utf8mb4_0900_ai_ci
max_connections              = 200
innodb_buffer_pool_size      = 1G         # staging-sized; raise on a real box
innodb_flush_log_at_trx_commit = 2        # staging only - not crash-safe per-txn
innodb_file_per_table        = ON
slow_query_log               = ON
long_query_time              = 1
slow_query_log_file          = /var/lib/mysql/slow.log

[client]
default-character-set = utf8mb4
